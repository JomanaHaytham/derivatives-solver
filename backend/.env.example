# Copy this file to .env and fill in your key. Never commit .env.
# Without a key the app still works: the symbolic engine writes the step-by-step
# solutions and a built-in tutor answers common follow-up questions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_ENABLED=true
AI_MAX_TOKENS=2500
AI_TIMEOUT_SECONDS=60
MATH_TIMEOUT_SECONDS=12
MAX_HISTORY_MESSAGES=16
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
